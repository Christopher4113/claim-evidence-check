ar % 400 == 0)", " ", " ", " def month_end(d: date) -> date:"]}], "userModified": false, "replaceAll": false, "contentNotInModelContext": true}, "sessionId": "3eb064f9-ee56-4414-ab34-a1c415338f98"}
